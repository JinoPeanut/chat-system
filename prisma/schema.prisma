generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  online
  offline
  AFK
}

enum UserRole {
  USER
  ADMIN
}

enum RoomType {
  personal
  group
}

enum NoticeCategory {
  notice
  event
  update
  etc
}

enum LeaveType {
  annual
  half_am
  half_pm
}

enum LeaveStatus {
  pending
  approved
  rejected
}

enum ProfileWork {
  office
  house
}

enum AdminActivityType {
  default
  notice
  leave
}

model User {
  id          String      @id
  name        String
  department  String
  position    String
  status      UserStatus  @default(offline)
  profilePic  String?
  email       String      @unique
  passwordHash  String
  createdAt   DateTime    @default(now())
  companyId   String
  role        UserRole    @default(USER)

  messages    Message[]   @relation("MessageSender")
  chatRooms   ChatRoom[]  @relation("ChatMembers")
  notices     Notice[]
  leaveBalance LeaveBalance?
  leaveHistory LeaveHistory[]
  profile     Profile?     @relation("profileUser")
  schedule    Schedule[]
  company     Company      @relation(fields: [companyId], references: [id])
  adminActivityLogs AdminActivityLog[]
}

model Message {
  id          String      @id
  senderId    String
  chatRoomId  String
  content     String      
  timeAt      DateTime    @default(now())
  
  sender      User        @relation("MessageSender", fields: [senderId], references: [id])
  chatRoom    ChatRoom    @relation(fields: [chatRoomId], references: [id])
}

model ChatRoom {
  id          String       @id
  room        RoomType
  members     User[]       @relation("ChatMembers")
  messages    Message[]
}

model Notice {
  id          String         @id
  category    NoticeCategory
  title       String
  content     String?
  createdAt   DateTime       @default(now())
  isPinned    Boolean        @default(false)
  authorId    String
  author      User           @relation(fields: [authorId], references: [id])
  attachments NoticeAttachment[]

  @@index([createdAt])
}

model NoticeAttachment {
  id          String          @id @default(uuid())
  noticeId    String
  fileName    String
  fileUrl     String
  fileSize    Int?
  fileType    String?
  createdAt   DateTime         @default(now())

  notice      Notice           @relation(fields: [noticeId], references: [id], onDelete: Cascade)
}

model Attendance {
  id          String          @id
  userId      String
  date        String
  checkInAt   Int?
  checkOutAt  Int?
  workMinutes Int?
}

model LeaveBalance {
  id          String          @id
  userId      String          @unique
  totalDays   Float
  usedDays    Float
  useHours    Int

  user        User             @relation(fields: [userId], references: [id])
}

model LeaveHistory {
  id          String           @id
  userId      String
  leaveDate   String
  usedDays    Float
  usedHours   Int
  leaveType   LeaveType
  status      LeaveStatus
  reason      String?
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id])
}

model Profile {
  userId      String           @id
  statusMsg   String?          
  statusWork  ProfileWork
  bestWorker  Boolean
  tel         String

  profileUser User             @relation("profileUser", fields: [userId], references: [id])
}

model Schedule {
  id        String   @id @default(uuid())
  userId    String
  title     String
  titleMemo String?
  content   String?
  startAt   DateTime
  endAt     DateTime?

  user      User     @relation(fields: [userId], references: [id])
}

model Company {
  id        String    @id
  name      String  
  inviteCode String   @unique

  users     User[]
}

model AdminActivityLog {
  id        String            @id @default(uuid())
  adminId   String
  companyId String
  type      AdminActivityType @default(default)
  message   String
  targetId  String?
  targetType String?
  createdAt DateTime          @default(now())

  admin     User              @relation(fields: [adminId], references: [id])

  @@index([companyId])
  @@index([createdAt])
}